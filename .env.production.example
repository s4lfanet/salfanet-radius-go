# ========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ========================================
# Copy this file to .env for production setup
# CRITICAL: Change all default values before deploying!

# ========================================
# DATABASE - MySQL/MariaDB
# ========================================
DATABASE_URL="mysql://username:password@localhost:3306/salfanet_radius?connection_limit=10&pool_timeout=20"

# ========================================
# TIMEZONE - CRITICAL for WIB handling
# ========================================
TZ="Asia/Jakarta"
NEXT_PUBLIC_TIMEZONE="Asia/Jakarta"

# ========================================
# APPLICATION CONFIGURATION
# ========================================
NEXT_PUBLIC_APP_NAME="Your ISP Name"
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
NODE_ENV="production"

# ========================================
# NEXTAUTH - CRITICAL SECURITY
# ========================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_THIS_TO_RANDOM_STRING_32_CHARS_MIN"
NEXTAUTH_URL="https://yourdomain.com"

# ========================================
# RADIUS SERVER CONFIGURATION
# ========================================
# Public IP for MikroTik scripts
RADIUS_SERVER_IP="YOUR_VPS_PUBLIC_IP"
VPS_IP="YOUR_VPS_PUBLIC_IP"

# ========================================
# PAYMENT GATEWAY - MIDTRANS
# ========================================
MIDTRANS_SERVER_KEY="your-midtrans-server-key"
MIDTRANS_CLIENT_KEY="your-midtrans-client-key"
MIDTRANS_IS_PRODUCTION="true"

# ========================================
# PAYMENT GATEWAY - XENDIT (Optional)
# ========================================
# XENDIT_SECRET_KEY="your-xendit-secret-key"
# XENDIT_WEBHOOK_TOKEN="your-xendit-webhook-token"

# ========================================
# EMAIL CONFIGURATION - Gmail SMTP
# ========================================
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-specific-password"
EMAIL_FROM="Your ISP Name <your-email@gmail.com>"

# ========================================
# WHATSAPP INTEGRATION (Optional)
# ========================================
# WHATSAPP_API_URL="https://your-whatsapp-gateway.com/api"
# WHATSAPP_API_KEY="your-api-key"

# ========================================
# SECURITY & PERFORMANCE
# ========================================
# Rate limiting
RATE_LIMIT_MAX="100"
RATE_LIMIT_WINDOW="15"

# Session
SESSION_MAX_AGE="86400"

# ========================================
# WEB PUSH / PWA
# ========================================
# Generate with: npm run push:vapid
VAPID_PUBLIC_KEY="YOUR_VAPID_PUBLIC_KEY"
VAPID_PRIVATE_KEY="YOUR_VAPID_PRIVATE_KEY"
VAPID_CONTACT_EMAIL="admin@yourdomain.com"

# ========================================
# GO BACKEND API (salfanet-go)
# ========================================
# Internal API URL (for Next.js server-side fetch)
GO_API_URL="http://127.0.0.1:8080"

# Go API server port
PORT="8080"

# JWT secret for Go API auth (generate with: openssl rand -base64 32)
JWT_SECRET="CHANGE_THIS_TO_RANDOM_STRING_32_CHARS_MIN"

# Go API CORS origins (comma-separated)
CORS_ORIGINS="https://yourdomain.com"

# Go API base URL
APP_BASE_URL="https://yourdomain.com"

# Timezone
APP_TIMEZONE="Asia/Jakarta"

# WhatsApp service URL
WA_SERVICE_URL="http://127.0.0.1:3001"

# Upload directory
UPLOAD_DIR="/var/data/salfanet/uploads"

# ========================================
# PAYMENT GATEWAY - TRIPAY (Optional)
# ========================================
# TRIPAY_API_KEY="your-tripay-api-key"
# TRIPAY_PRIVATE_KEY="your-tripay-private-key"
# TRIPAY_MERCHANT_CODE="your-tripay-merchant-code"

# ========================================
# PAYMENT GATEWAY - DUITKU (Optional)
# ========================================
# DUITKU_MERCHANT_CODE="your-duitku-merchant-code"
# DUITKU_API_KEY="your-duitku-api-key"

# ========================================
# PAYMENT GATEWAY - XENDIT (Optional)
# ========================================
# XENDIT_API_KEY="your-xendit-api-key"

# ========================================
# WEB PUSH / PWA (Go backend)
# ========================================
VAPID_PUBLIC_KEY="YOUR_VAPID_PUBLIC_KEY"
VAPID_PRIVATE_KEY="YOUR_VAPID_PRIVATE_KEY"
VAPID_EMAIL="admin@yourdomain.com"

# ========================================
# LOGGING & MONITORING
# ========================================
LOG_LEVEL="error"
ENABLE_QUERY_LOGGING="false"
