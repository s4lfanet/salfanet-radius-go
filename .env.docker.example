# ============================================================================
# SALFANET RADIUS — Docker Environment Configuration
# ============================================================================
# Copy this file to .env.docker and fill in your values:
#   cp .env.docker.example .env.docker
#   nano .env.docker
#
# Then run:
#   docker compose --env-file .env.docker -f docker-compose.full.yml up -d
#
# Or use the installer:
#   bash docker-install.sh
# ============================================================================

# ─── Database ────────────────────────────────────────────────────────────────
DB_NAME=salfanet_radius
DB_USER=salfanet_user
# CHANGE THESE! Generate with: openssl rand -base64 16
DB_PASSWORD=CHANGE_THIS_DB_PASSWORD
DB_ROOT_PASSWORD=CHANGE_THIS_ROOT_PASSWORD

# ─── JWT & Auth Secrets ──────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_RANDOM_64_CHAR_STRING
NEXTAUTH_SECRET=CHANGE_THIS_TO_RANDOM_64_CHAR_STRING
AGENT_JWT_SECRET=CHANGE_THIS_TO_RANDOM_64_CHAR_STRING

# ─── Encryption Key ──────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 16
ENCRYPTION_KEY=CHANGE_THIS_TO_RANDOM_32_HEX

# ─── Application URLs ────────────────────────────────────────────────────────
# Your server's public IP or domain
APP_BASE_URL=http://YOUR_SERVER_IP
RADIUS_SERVER_IP=YOUR_SERVER_IP

# CORS origins (comma-separated)
CORS_ORIGINS=http://YOUR_SERVER_IP,https://yourdomain.com

# ─── RADIUS Shared Secret ────────────────────────────────────────────────────
# Secret used between FreeRADIUS and your NAS/router
RADIUS_SHARED_SECRET=CHANGE_THIS_RADIUS_SECRET

# ─── VAPID Keys (PWA Push Notifications) ─────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=admin@yourdomain.com

# ─── GenieACS (Optional) ─────────────────────────────────────────────────────
GENIEACS_URL=
GENIEACS_USERNAME=
GENIEACS_PASSWORD=

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=error
